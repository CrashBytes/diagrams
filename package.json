{
  "name": "@crashbytes/diagrams",
  "version": "1.0.1",
  "description": "Programmatic text-to-diagram generation with fluent TypeScript API. Renders to Mermaid markdown. Zero dependencies.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "diagram",
    "mermaid",
    "flowchart",
    "sequence-diagram",
    "typescript",
    "markdown",
    "graph",
    "visualization",
    "code-to-diagram"
  ],
  "author": "CrashBytes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrashBytes/diagrams.git"
  },
  "bugs": {
    "url": "https://github.com/CrashBytes/diagrams/issues"
  },
  "homepage": "https://github.com/CrashBytes/diagrams#readme",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
